cabal-version:       3.0
build-type:          Simple
name:                hpqtypes-opentelemetry
version:             0.1.0.0
synopsis:            OpenTelemetry tracing for hpqtypes

description:         Creates an OpenTelemetry span for each query that hpqtypes
                     runs, following the semantic conventions for database
                     client spans.

homepage:            https://github.com/scrive/hpqtypes
license:             BSD-3-Clause
license-file:        LICENSE
author:              Scrive AB
maintainer:          Andrzej Rybczak <andrzej@rybczak.net>
copyright:           Scrive AB
category:            Database
tested-with:         GHC ^>= { 9.2, 9.4, 9.6, 9.8, 9.10, 9.12, 9.14 }

extra-doc-files:     CHANGELOG.md

source-repository head
  type:     git
  location: https://github.com/scrive/hpqtypes.git
  subdir:   hpqtypes-opentelemetry

common language
  default-language:   Haskell2010
  default-extensions: ConstraintKinds
                    , DerivingStrategies
                    , GeneralizedNewtypeDeriving
                    , ImportQualifiedPost
                    , LambdaCase
                    , NamedFieldPuns
                    , OverloadedStrings
                    , RankNTypes
                    , ScopedTypeVariables
                    , TupleSections
                    , TypeApplications

library
  import:              language
  exposed-modules:     Database.PostgreSQL.PQTypes.OpenTelemetry
                     , Database.PostgreSQL.PQTypes.OpenTelemetry.QuerySummary
  other-modules:       Paths_hpqtypes_opentelemetry
  autogen-modules:     Paths_hpqtypes_opentelemetry

  build-depends:       base                 >= 4.16    && < 5
                     , containers           >= 0.6.0.1
                     , hpqtypes             >= 1.16    && < 1.17
                     , hs-opentelemetry-api >= 1.0     && < 1.1
                     , text                 >= 0.11
                     , unordered-containers >= 0.2

  hs-source-dirs:      src

  ghc-options:         -Wall -Werror=prepositive-qualified-module

test-suite test
  import:              language
  type:                exitcode-stdio-1.0
  ghc-options:         -Wall -Werror=prepositive-qualified-module -threaded

  hs-source-dirs:      test
  main-is:             Main.hs
  other-modules:       QuerySummaryTest

  build-depends:       hpqtypes-opentelemetry
                     , base
                     , HUnit                              >= 1.2
                     , hpqtypes
                     , hs-opentelemetry-api
                     , hs-opentelemetry-exporter-in-memory >= 1.0 && < 1.1
                     , test-framework                     >= 0.8
                     , test-framework-hunit               >= 0.3
                     , text
                     , vector

benchmark bench
  import:              language
  type:                exitcode-stdio-1.0
  ghc-options:         -Wall -Werror=prepositive-qualified-module -threaded -rtsopts "-with-rtsopts=-A32m"

  hs-source-dirs:      bench
  main-is:             Main.hs

  build-depends:       hpqtypes-opentelemetry
                     , base
                     , tasty-bench                        >= 0.3 && < 0.6
                     , text
